<h2 id="fbt-title">BMI calculator</h2>
<p id="fbt-desc">Fixture: a control button inside a form, with no type attribute.</p>
<form aria-describedby="fbt-desc">
  <label for="fbt-kg">Weight (kg)</label>
  <input id="fbt-kg" type="number" value="70">
  <button id="fbt-go" onclick="fbtCalc()">Calculate BMI</button>
</form>
<p id="fbt-out">—</p>
<script>
  function fbtCalc() {
    var kg = Number(document.getElementById('fbt-kg').value) || 0;
    document.getElementById('fbt-out').textContent = (kg / (1.75 * 1.75)).toFixed(1);
  }
</script>
