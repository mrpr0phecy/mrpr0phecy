<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Plot Generator (fixture: the bug as it shipped)</title></head>
<body>
<div class="card" id="plot-panel">
  <h2 id="plot-title"></h2><p id="plot-desc"></p><div id="plot-structure"></div>
  <button id="generatePlot">Generate</button>
</div>
<script>
  // creative-writing.html as it shipped: 12 titles, 8 descriptions, 8 structures.
  const plotTitles = ['a','b','c','d','e','f','g','h','i','j','k','l'];
  const plotDescriptions = ['one','two','three','four','five','six','seven','eight'];
  const plotStructures = [
    ['Act 1'], ['Act 1'], ['Act 1'], ['Act 1'],
    ['Act 1'], ['Act 1'], ['Act 1'], ['Act 1'],
  ];
  const plotTitle = document.querySelector('#plot-title');
  const plotDesc = document.querySelector('#plot-desc');
  const plotStructure = document.querySelector('#plot-structure');
  document.getElementById('generatePlot').addEventListener('click', () => {
    const plotIndex = Math.floor(Math.random() * plotTitles.length);
    plotTitle.textContent = plotTitles[plotIndex];
    plotDesc.textContent = plotDescriptions[plotIndex];
    plotStructure.innerHTML = plotStructures[plotIndex]
      .map(point => `<div class="plot-point">${point}</div>`)
      .join('');
  });
</script>
</body></html>
