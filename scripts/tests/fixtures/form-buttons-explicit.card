<h2 id="fbe-title">BMI calculator</h2>
<p id="fbe-desc">Fixture: the same form, wired so a click cannot navigate.</p>
<form aria-describedby="fbe-desc" onsubmit="event.preventDefault();">
  <label for="fbe-kg">Weight (kg)</label>
  <input id="fbe-kg" type="number" value="70">
  <button id="fbe-go" type="button" onclick="fbeCalc()">Calculate BMI</button>
</form>
<p id="fbe-out">—</p>
<script>
  function fbeCalc() {
    var kg = Number(document.getElementById('fbe-kg').value) || 0;
    document.getElementById('fbe-out').textContent = (kg / (1.75 * 1.75)).toFixed(1);
  }
</script>
