<h2 id="init-stmtelse-title">The one-line idiom</h2>
<p id="init-stmtelse-desc">Fixture: the brace-less guard with its else — the exact idiom CONSTRAINTS.md documents.</p>
<div class="card">
  <div id="init-stmtelse-rows"></div>
</div>
<script>
(function () {
  function init() {
    var host = document.getElementById('init-stmtelse-rows');
    if (!host) return;
    host.textContent = 'ready';
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  // the same shape with a function argument, whose first `;` is inside it
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(); });
  else { init(); }
})();
</script>
