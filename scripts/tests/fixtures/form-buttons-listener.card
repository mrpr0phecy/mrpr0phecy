<h2 id="fbl-title">Search the catalogue</h2>
<p id="fbl-desc">Fixture: a real submit button whose form handles its own submission.</p>
<form id="fbl-form" aria-describedby="fbl-desc">
  <label for="fbl-q">Term</label>
  <input id="fbl-q" type="search" value="percent">
  <button type="submit" id="fbl-go">Search</button>
</form>
<p id="fbl-out">—</p>
<script>
  document.getElementById('fbl-form').addEventListener('submit', function (event) {
    event.preventDefault();
    var q = document.getElementById('fbl-q').value;
    document.getElementById('fbl-out').textContent = q.length + ' characters';
  });
</script>
