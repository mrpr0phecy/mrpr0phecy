<h2 id="grid-title">A grid of nameless fields</h2>
<p id="grid-desc">Fixture: four cells of the shape every scorecard in the catalogue builds — a bare number input per cell, one data attribute to tell them apart.</p>
<div class="card">
  <div id="grid-rows"></div>
</div>
<script>
  (function () {
    'use strict';
    var box = document.getElementById('grid-rows');
    // Built the way the scorecards do it: a number input per cell, no label,
    // the only thing distinguishing one from another is data-i.
    box.innerHTML = [0, 1, 2, 3].map(function (i) {
      return '<input type="number" min="0" max="9" value="0" data-i="' + i + '">';
    }).join('');
  })();
</script>
