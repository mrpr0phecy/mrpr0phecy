<h2 id="init-rx-title">A regex after return</h2>
<p id="init-rx-desc">Fixture: a regex literal with a quote in it, right after `return`, before the init idiom.</p>
<div class="card">
  <div id="init-rx-rows"></div>
</div>
<script>
(function () {
  function csvCell(s) {
    // the masker used to read this regex as a division and the quote inside
    // it as the start of a string that ran to the end of the script
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  }
  function init() {
    var host = document.getElementById('init-rx-rows');
    if (host) host.textContent = csvCell('ready');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
