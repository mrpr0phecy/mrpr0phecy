<h2 id="hcb-title">Copy my results</h2>
<p id="hcb-desc">Fixture: the shape that shipped in fourteen cards.</p>
<div class="card">
  <p id="hcb-out">nothing yet</p>
  <button type="button" onclick="hcbCopy(), this)"" id="hcb-copy">Copy results</button>
</div>
<script>
  function hcbCopy(trigger) {
    var out = document.getElementById('hcb-out');
    if (out) out.textContent = trigger ? 'copied from a click' : 'copied without a trigger';
  }
</script>
