<h2 id="unnamed-title">Controls with nothing to read out</h2>
<p id="unnamed-desc">Fixture: a colour swatch, an icon-only link and a bare slider.</p>
<div class="card">
  <button type="button" id="unnamed-swatch" style="background:#0077cc;width:24px;height:24px"></button>
  <a href="#unnamed-title"><svg viewBox="0 0 16 16"><path d="M2 2h12v12H2z"/></svg></a>
  <input type="range" id="unnamed-slider" min="0" max="10" value="4">
</div>
