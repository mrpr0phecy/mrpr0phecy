<h2 id="leftovers-copy-title">A helper that cleans up after itself</h2>
<p id="leftovers-copy-desc">Fixture: the three legitimate shapes — the transient copy helper, the toast on its own timer, and a third-party library script.</p>
<div class="card">
  <button type="button" id="leftovers-copy">Copy</button>
  <button type="button" id="leftovers-toast">Ping</button>
</div>
<script>
  document.getElementById('leftovers-copy').addEventListener('click', function () {
    const helper = document.createElement('textarea');
    helper.value = 'copied';
    document.body.appendChild(helper);
    helper.select();
    document.body.removeChild(helper);
  });
  document.getElementById('leftovers-toast').addEventListener('click', function () {
    const toast = document.createElement('div');
    toast.textContent = 'Saved';
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 1500);
  });
  function loadPlayerApi() {
    if (document.querySelector('script[src*="example.com/player"]')) return;
    const tag = document.createElement('script');
    tag.src = 'https://example.com/player.js';
    document.head.appendChild(tag);
  }
  window.__leftoversLoadPlayerApi = loadPlayerApi;
</script>
