<h2 id="dup-real-title">Two of the same id</h2>
<p id="dup-real-desc">Fixture: the markup really does contain the id twice.</p>
<div class="card">
  <span id="dup-real-count">0</span>
  <span id="dup-real-count">0</span>
  <button type="button" id="dup-real-go">Count</button>
</div>
<script>
  document.getElementById('dup-real-go').addEventListener('click', function () {
    // getElementById resolves to the first span, so the second one can never
    // show anything the code writes.
    document.getElementById('dup-real-count').textContent = 'clicked';
  });
</script>
