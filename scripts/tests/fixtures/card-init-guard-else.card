<h2 id="init-else-title">Starts either way</h2>
<p id="init-else-desc">Fixture: the guard with its else branch — the shape the other 95 cards have.</p>
<div class="card">
  <div id="init-else-rows"></div>
</div>
<script>
  function cardInitElseInit() {
    const host = document.getElementById('init-else-rows');
    if (!host) return;
    const row = document.createElement('div');
    row.textContent = 'ready';
    host.appendChild(row);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', cardInitElseInit);
  } else {
    cardInitElseInit();
  }
</script>
