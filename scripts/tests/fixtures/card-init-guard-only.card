<h2 id="init-guard-title">Starts only while loading</h2>
<p id="init-guard-desc">Fixture: the card's whole start-up sits inside a guard that tool.html never takes.</p>
<div class="card">
  <div id="init-guard-rows"></div>
</div>
<script>
  // tool.html injects this fragment into a document that finished loading long
  // ago, so `readyState === 'loading'` is false when these lines run: the
  // listener is never registered and the card never starts.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      const host = document.getElementById('init-guard-rows');
      if (!host) return;
      const row = document.createElement('div');
      row.textContent = 'ready';
      host.appendChild(row);
    });
  }
</script>
