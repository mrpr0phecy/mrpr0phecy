<h2 id="ref-nowhere-title">References that resolve to nothing</h2>
<p id="ref-nowhere-desc">Fixture: a label and a description aimed at ids nothing carries.</p>
<div class="card">
  <label for="ref-nowhere-depth">Depth (m)</label>
  <input id="ref-nowhere-depth-input" type="number">
  <input id="ref-nowhere-notes" aria-describedby="ref-nowhere-help">
  <button type="button" id="ref-nowhere-go" aria-labelledby="ref-nowhere-heading">Go</button>
</div>
