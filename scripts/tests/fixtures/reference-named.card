<h2 id="ref-named-title">Every control carries a name</h2>
<p id="ref-named-desc">Fixture: the same shapes as the failing one, each wired up.</p>
<div class="card">
  <label for="ref-named-depth">Depth (m)</label>
  <input id="ref-named-depth" type="number" aria-describedby="ref-named-help">
  <p id="ref-named-help">In metres, below the waterline.</p>
  <button type="button" id="ref-named-go" aria-labelledby="ref-named-heading">Go</button>
  <h3 id="ref-named-heading" hidden>Recalculate</h3>
  <button type="button" id="ref-named-icon"><img src="x.png" alt="Copy to clipboard"></button>
  <button type="button" id="ref-named-title-attr" title="Reset the form"></button>
  <label><input type="checkbox" id="ref-named-wrapped"> Include weekends</label>
  <input id="ref-named-ph" type="text" placeholder="Filter the list">
  <input id="ref-named-color" type="color" aria-label="Chart colour">
  <input type="hidden" id="ref-named-hidden" name="token">
  <input type="submit" value="Save">
</div>
