<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Clamped (fixture: a note, not a defect)</title></head>
<body>
<div class="card"><span id="quote"></span><button id="next">Next</button></div>
<script>
  // One index over two arrays assumed parallel, with the shorter one guarded at
  // the read. Nothing is undefined here and nothing throws, so it is not a
  // failure — but the assumption that the arrays line up is still wrong, and
  // the third ending is never used because the draw can only reach two of them.
  // That is what the note is for.
  const openings = ['It was', 'They said', 'Nobody', 'The room', 'Afterwards'];
  const closings = ['a beginning.', 'a warning.', 'a lie.'];
  function pick() {
    const i = Math.floor(Math.random() * openings.length);
    return `${openings[i]} ${closings[i] ?? 'a silence.'}`;
  }
  document.getElementById('quote').textContent = pick();
  document.getElementById('next').addEventListener('click', () => {
    document.getElementById('quote').textContent = pick();
  });
</script>
</body></html>
