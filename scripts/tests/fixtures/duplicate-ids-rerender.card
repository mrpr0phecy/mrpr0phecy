<h2 id="dup-re-title">One id, rendered twice</h2>
<p id="dup-re-desc">Fixture: the source text names the id twice, the DOM has one.</p>
<div class="card">
  <button type="button" id="dup-re-toggle">
    Favourites (<span id="dup-re-count">0</span>)
  </button>
</div>
<script>
  var favourites = 0;
  document.getElementById('dup-re-toggle').addEventListener('click', function () {
    favourites += 1;
    // The same id the markup above carries: innerHTML replaces the old span
    // rather than adding a second one, which is what the source-text scan
    // could not tell apart.
    this.innerHTML = 'Favourites (<span id="dup-re-count">' + favourites + '</span>)';
  });
</script>
