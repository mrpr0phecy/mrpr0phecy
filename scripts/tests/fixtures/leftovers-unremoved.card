<h2 id="leftovers-dialog-title">A dialog that outlives the card</h2>
<p id="leftovers-dialog-desc">Fixture: the card parks a modal in document.body and never removes it.</p>
<div class="card">
  <button type="button" id="leftovers-open">Share</button>
</div>
<script>
  document.getElementById('leftovers-open').addEventListener('click', function () {
    const shareDialog = document.createElement('div');
    shareDialog.id = 'leftovers-share';
    shareDialog.textContent = 'Shared.';
    // tool.html clears the card's container, not the document: this stays on
    // screen over the tool the visitor opens next.
    document.body.appendChild(shareDialog);
  });
</script>
