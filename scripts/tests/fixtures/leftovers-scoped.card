<h2 id="leftovers-scoped-title">Inside the card is inside the card</h2>
<p id="leftovers-scoped-desc">Fixture: the same modal, appended into the card's own container.</p>
<div class="card">
  <button type="button" id="leftovers-scoped-open">Share</button>
</div>
<script>
  const scopedRoot = (document.currentScript && document.currentScript.closest('.card')) || document.body;
  document.getElementById('leftovers-scoped-open').addEventListener('click', function () {
    const shareDialog = document.createElement('div');
    shareDialog.textContent = 'Shared.';
    scopedRoot.appendChild(shareDialog);
  });
</script>
