<h2 id="sel-title">Not named by what it holds</h2>
<p id="sel-desc">Fixture: a select whose only text is its options, a textarea whose only text is its value, and a button named by its own label.</p>
<div class="card">
  <select id="sel-currency">
    <option value="gbp" selected>£ GBP</option>
    <option value="usd">$ USD</option>
  </select>
  <select id="sel-labelled" aria-label="Units">
    <option value="km">Kilometres</option>
  </select>
  <textarea id="sel-notes">Draft text that is a value, not a name</textarea>
  <button type="button" id="sel-save">Save</button>
</div>
