<h2 id="hcg-title">Copy my results</h2>
<p id="hcg-desc">Fixture: the same control, wired so it can fire.</p>
<div class="card">
  <p id="hcg-out">nothing yet</p>
  <button type="button" onclick="hcgCopy(this)" id="hcg-copy">Copy results</button>
  <button type="button" onclick="hcgReset()" id="hcg-reset">Reset</button>
</div>
<script>
  function hcgCopy(trigger) {
    var out = document.getElementById('hcg-out');
    if (out) out.textContent = trigger ? 'copied from a click' : 'copied without a trigger';
  }
  function hcgReset() {
    var out = document.getElementById('hcg-out');
    if (out) out.textContent = 'nothing yet';
  }
  document.getElementById('hcg-copy').addEventListener('click', function () {
    this.style.opacity = '0.7';
  });
</script>
