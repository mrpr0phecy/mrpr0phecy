<h2 id="init-other-title">A loading check about something else</h2>
<p id="init-other-desc">Fixture: `readyState` used for its own sake, with no listener involved.</p>
<div class="card">
  <p id="init-other-note"></p>
</div>
<script>
  // Not every readyState test is an init guard: this one only decides whether to
  // mention the loader's timing. Nothing to fix, and the check must stay quiet.
  if (document.readyState === 'loading') {
    document.getElementById('init-other-note').textContent = 'still loading';
  }
  window.__cardInitOther = true;
</script>
