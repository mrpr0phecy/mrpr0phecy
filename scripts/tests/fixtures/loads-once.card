<h2 id="load-once-title">One document, one start</h2>
<p id="load-once-desc">Fixture: the card builds a row per DOMContentLoaded, as many cards do.</p>
<div class="card">
  <div id="load-once-rows"></div>
</div>
<script>
  // A card that appends without clearing shows up as a duplicate id when the
  // event fires twice, which is how the harness noticed it was dispatching
  // DOMContentLoaded into a document jsdom had not finished parsing.
  document.addEventListener('DOMContentLoaded', function () {
    var host = document.getElementById('load-once-rows');
    if (!host) return;
    var row = document.createElement('div');
    row.id = 'load-once-row';
    row.textContent = 'row';
    host.appendChild(row);
  });
</script>
