<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Look-alikes (fixture: none of these is the bug)</title></head>
<body>
<div class="card"><span id="a"></span><span id="b"></span><span id="c"></span></div>
<script>
  /* 1. One array indexed by an index drawn from its own length: always in range. */
  const flavours = ['vanilla','mint','rum'];
  document.getElementById('a').textContent =
    flavours[Math.floor(Math.random() * flavours.length)];

  /* 2. Two arrays indexed by one variable, and they are the same length: parallel,
        which is exactly what the check is looking for. */
  const suits = ['hearts','spades','clubs'];
  const pips = ['A','K','Q'];
  const pick = Math.floor(Math.random() * suits.length);
  document.getElementById('b').textContent = `${pips[pick]} of ${suits[pick]}`;

  /* 3. A table where one array is longer than the other on purpose, indexed by a
        counter that walks its own array — not a shared random draw. */
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const starts = ['Wed','Sat','Sat','Tue','Thu','Sun','Tue','Fri','Mon','Wed','Fri','Mon'];
  let row = '';
  for (let i = 0; i < months.length; i++) row += `${months[i]} starts on a ${starts[i % starts.length]}; `;
  document.getElementById('c').textContent = row;
</script>
</body></html>
