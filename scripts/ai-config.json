{
  "version": 1,
  "description": "AI Developer configuration for mrpr0phecy/mrpr0phecy",

  "priorities": {
    "fix_broken_tools": 1,
    "add_high_demand_tools": 2,
    "improve_weak_categories": 3,
    "enhance_existing_tools": 4
  },

  "target_categories": {
    "weakest_first": true,
    "min_avg_size_bytes": 10000,
    "max_tools_per_category": 20
  },

  "tool_quality": {
    "min_size_bytes": 2000,
    "max_size_bytes": 30000,
    "require_script_tag": true,
    "require_unique_id_prefix": true,
    "require_iife_wrapper": true,
    "forbid_external_dependencies": true
  },

  "high_demand_tools": [
    "json-formatter",
    "base64-encoder",
    "password-generator",
    "color-picker",
    "word-counter",
    "regex-tester",
    "url-encoder",
    "timestamp-converter",
    "uuid-generator",
    "hash-generator",
    "markdown-preview",
    "csv-converter",
    "yaml-converter",
    "xml-formatter",
    "html-encoder",
    "css-gradient-generator",
    "box-shadow-generator",
    "border-radius-generator",
    "font-preview",
    "image-compressor",
    "qr-code-generator",
    "barcode-generator",
    "lorem-ipsum",
    "placeholder-image",
    "cron-parser",
    "jwt-decoder",
    "dns-lookup",
    "ip-lookup",
    "whois-lookup",
    "ssl-checker",
    "http-headers",
    "user-agent-parser",
    "browser-info",
    "screen-info",
    "battery-status",
    "network-speed",
    "clipboard-manager",
    "text-diff",
    "json-diff",
    "xml-diff",
    "base64-image",
    "svg-optimizer",
    "css-minifier",
    "js-minifier",
    "html-minifier",
    "sql-formatter",
    "graphql-playground",
    "websocket-tester",
    "api-tester",
    "mock-data-generator"
  ],

  "excluded_tools": [
    "aiwalker.html",
    "evolution-walker.html",
    "evolution-arena-3d.html"
  ],

  "schedule": {
    "audit_interval_days": 7,
    "generate_interval_days": 3,
    "max_prs_per_week": 2
  }
}
