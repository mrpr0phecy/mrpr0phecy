{
  "version": "2026-10-06",
  "count": 13,
  "about": "Deterministic routing for the home page's solve box: a query that matches a pattern becomes a link to that tool with the values filled in. Nothing is sent anywhere — the match and the URL are built in the visitor's browser, and anything not matched falls through to the normal catalogue search. Every field id and every &run=1 is validated against the card at build time.",
  "url": "https://www.themostusefulsiteintheworld.com/intents.json",
  "limits": {
    "params": 40,
    "valueChars": 512,
    "urlChars": 1800
  },
  "intents": [
    {
      "id": "percent-of",
      "title": "Percentage Calculator",
      "card": "percentage-calculator",
      "pattern": "^(?:what\\s+is\\s+|what's\\s+|how\\s+much\\s+is\\s+|calculate\\s+)?(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)\\s+of\\s+(\\d+(?:\\.\\d+)?)\\s*\\??\\s*$",
      "fills": {
        "pct-a": "$1",
        "pct-b": "$2",
        "pct-mode": "what"
      },
      "run": true,
      "example": "20% of 340",
      "exampleUrl": "https://www.themostusefulsiteintheworld.com/tool.html?card=percentage-calculator&pct-a=20&pct-b=340&pct-mode=what&run=1",
      "note": "X% of Y — the answer is Y × X ÷ 100."
    },
    {
      "id": "percent-off",
      "title": "Percentage Calculator",
      "card": "percentage-calculator",
      "pattern": "^(?:what\\s+is\\s+|what's\\s+|how\\s+much\\s+is\\s+|calculate\\s+)?(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)\\s+off\\s+(\\d+(?:\\.\\d+)?)\\s*\\??\\s*$",
      "fills": {
        "pct-mode": "discount",
        "pct-a": "$1",
        "pct-b": "$2"
      },
      "run": true,
      "example": "15% off 80",
      "exampleUrl": "https://www.themostusefulsiteintheworld.com/tool.html?card=percentage-calculator&pct-mode=discount&pct-a=15&pct-b=80&run=1",
      "note": "X% off Y — the discounted price, not just the saving."
    },
    {
      "id": "percent-change",
      "title": "Percentage Change Calculator",
      "card": "percentage-change-calculator",
      "pattern": "^(?:what\\s+is\\s+the\\s+)?(?:percentage|percent)\\s+(?:change|increase|difference)\\s+from\\s+(\\d+(?:\\.\\d+)?)\\s+to\\s+(\\d+(?:\\.\\d+)?)\\s*\\??\\s*$",
      "fills": {
        "pct-from": "$1",
        "pct-to": "$2"
      },
      "run": true,
      "example": "percentage change from 40 to 55",
      "exampleUrl": "https://www.themostusefulsiteintheworld.com/tool.html?card=percentage-change-calculator&pct-from=40&pct-to=55&run=1",
      "note": "Old value → new value, as a percentage up or down."
    },
    {
      "id": "tip-percent-first",
      "title": "Tip Calculator",
      "card": "tip-calculator",
      "pattern": "^(?:what\\s+is\\s+|what's\\s+|how\\s+much\\s+is\\s+|calculate\\s+)?(?:a\\s+)?(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)\\s+tip\\s+(?:on|for)\\s+(?:a\\s+)?(\\d+(?:\\.\\d+)?)\\s*\\??\\s*$",
      "fills": {
        "tc-tip-percent": "$1",
        "tc-bill": "$2"
