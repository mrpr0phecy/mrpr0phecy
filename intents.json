      "card": "datecalc",
      "pattern": "^(?:days|difference|how\\s+many\\s+days)\\s+between\\s+(\\d{4}-\\d{2}-\\d{2})\\s+and\\s+(\\d{4}-\\d{2}-\\d{2})\\s*\\??\\s*$",
