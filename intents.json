      "card": "compoundinterest",
      "pattern": "^compound(?:\\s+interest)?\\s+(?:on\\s+)?[£$€]?\\s*(\\d{2,9})\\s*(?:at|@)\\s*(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)(?:\\s*(?:over|for)\\s*(\\d{1,3})\\s*(?:years?|yrs?))?\\s*\\??\\s*$",
