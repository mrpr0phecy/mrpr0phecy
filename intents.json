    {
      "id": "mortgage",
      "title": "Mortgage Calculator",
      "card": "mortgage",
      "pattern": "^(?:mortgage|home\\s+loan)\\s+(?:of\\s+)?[£$€]?\\s*(\\d+(?:\\.\\d+)?)\\s*(?:at|@)\\s*(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)(?:\\s*(?:over|for)\\s*(\\d{1,3})\\s*(?:years?|yrs?))?\\s*\\??\\s*$",
      "fills": {
