    {
      "id": "born",
      "title": "Age Calculator",
      "card": "age-calculator",
      "pattern": "^(?:how\\s+old\\s+am\\s+i\\s+)?(?:if\\s+i\\s+was\\s+)?born\\s+(?:on\\s+)?(\\d{4}-\\d{2}-\\d{2})\\s*\\??\\s*$",
      "fills": {
