      "run": true,
      "example": "15% tip on 62",
      "exampleUrl": "https://www.themostusefulsiteintheworld.com/tool.html?card=tip-calculator&tc-tip-percent=15&tc-bill=62&run=1",
      "note": "The bill plus the tip, and the total."
    },
