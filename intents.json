      "card": "tip-calculator",
      "pattern": "^(?:tip|service)\\s+(?:of\\s+)?(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)\\s+(?:on|for)\\s+(?:a\\s+)?(\\d+(?:\\.\\d+)?)\\s*\\??\\s*$",
      "fills": {
