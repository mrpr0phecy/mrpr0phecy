# Second Life Bot Account - CREATE A THROWAWAY BOT ACCOUNT, DON'T USE YOUR MAIN
# Linden Lab requires bots to be marked as bots in account settings
# Create at https://join.secondlife.com/

SL_FIRSTNAME=ArenaBot
SL_LASTNAME=Resident
SL_PASSWORD=your_bot_password_here

# Where to go find Supadupaman Sapphire - now defaults to Natoma
# You can use 'last' to go to last location, or 'home', or a region name
SL_START=Natoma/128/128/22

# Who to look for and greet
TARGET_NAME=Supadupaman Sapphire
TARGET_REGION=Natoma
TARGET_X=128
TARGET_Y=128
TARGET_Z=22

# What the bot says
GREETING=Hi Supadupaman Sapphire! I'm the Arena bot from themostusefulsiteintheworld.com - you asked me to come visit you. o/

# Optional: Discord webhook to notify when bot arrives
DISCORD_WEBHOOK=
